Bool.arms : ∀x0 : <False, True> -> *2 =
  λ{.False: <()>; λ{.True: <()>; λ{}}}

Bool : *2 =
  Σx0 : <False, True> -> (Bool.arms x0)

List.q2.arms : ∀-x0 : *2 -> ∀x1 : <Nil, Con> -> *2 =
  λ-x0 => λ{.Nil: <()>; λ{.Con: Σx1 : x0 -> Σx2 : (List.q2 -x0) -> <()>; λ{}}}

List.q2 : ∀-x0 : *2 -> *2 =
  λ-x0 => Σx1 : <Nil, Con> -> (List.q2.arms -x0 x1)

Either.q11.arms : ∀-x0 : *1 -> ∀-x1 : *1 -> ∀x2 : <Inl, Inr> -> *1 =
  λ-x0 => λ-x1 => λ{.Inl: Σx2 : x0 -> <()>; λ{.Inr: Σx2 : x1 -> <()>; λ{}}}

Either.q11 : ∀-x0 : *1 -> ∀-x1 : *1 -> *1 =
  λ-x0 => λ-x1 => Σx2 : <Inl, Inr> -> (Either.q11.arms -x0 -x1 x2)

Nat.arms : ∀x0 : <Zero, Succ> -> *2 =
  λ{.Zero: <()>; λ{.Succ: Σx0 : Nat -> <()>; λ{}}}

Nat : *2 =
  Σx0 : <Zero, Succ> -> (Nat.arms x0)
