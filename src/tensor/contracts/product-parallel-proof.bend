# The parallel product over replayed inputs, for operands laid out in any
# orders lo and ro: the proof of the parallel matmul over replayed inputs
# with each operand read at `Matrix.read_index`. Its output is the replayed
# storage that writes, in index order, the word `product_ordered` names at
# each cell.

# The extents of an operand of `outers` rows (or columns) and `inner` terms
# laid out in `order`.
def Fits(+order: Matrix.Order, +inner: Nat, +outers: Nat, -shape: Shape.Shape) -> Data:
  match order:
    case Matrix.Kept{}:
      {Shape.extents(shape) == [outers, inner] : List<&2, Nat>}
    case Matrix.Swapped{}:
      {Shape.extents(shape) == [inner, outers] : List<&2, Nat>}

# Factor k of output row (or column) `outer` lies inside its operand.
def read_below(+order: Matrix.Order, +inner: Nat, +outers: Nat, +outer: Nat,
  outer_below: {Nat.is_lt(outer, outers) == True{} : Bool}, +shape: Shape.Shape, fits: Fits(order, inner, outers, shape),
  +k: Nat, below: {Nat.is_lt(k, inner) == True{} : Bool}) ->
  {Nat.is_lt(Matrix.read_offset(order, inner, outers, outer, k), Shape.logical_numel(Shape.dimensions(shape))) == True{} : Bool}:
  match order:
    case Matrix.Kept{}:
      MatrixIndex.left_below(outers, inner, outer, outer_below, shape, fits, k, below)
    case Matrix.Swapped{}:
      MatrixIndex.right_below(inner, outers, outer, outer_below, shape, fits, k, below)

def cell_word(+lo: Matrix.Order, +ro: Matrix.Order, +inner: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>,
  +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +position: Nat) -> F32:
  DotFold.dot_fold(Laws.product_factors(Matrix.row_of(columns, position), Matrix.column_of(columns, position), lo, ro, inner, rows, columns,
    left, left_fill, left_ops, right, right_fill, right_ops, inner), 0.0)

def writes(+lo: Matrix.Order, +ro: Matrix.Order, +inner: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>,
  +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +count: Nat) -> List<&2, StorageLaws.Op>:
  match count:
    case 0n:
      Nil{}
    case 1n+previous:
      Replayed.snoc(writes(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, previous),
        StorageLaws.Write{U32.from_nat(previous), cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, previous)})

def writes_value(+lo: Matrix.Order, +ro: Matrix.Order, +inner: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>,
  +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +output: Shape.Shape, +count: Nat, +index: U32,
  below: {Nat.is_lt(U32.to_nat(index), count) == True{} : Bool},
  +room: {Nat.is_le(count, Shape.logical_numel(Shape.dimensions(output))) == True{} : Bool}) ->
  {Replayed.value(output, 0.0, writes(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count), index) ==
    cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(index)) : F32}:
  match count:
    case 0n:
      Empty.absurd({Replayed.value(output, 0.0, Nil{}, index) ==
        cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(index)) : F32},
        Arith.lt_zero(U32.to_nat(index), below))
    case 1n+previous:
      PointwiseProof.write_split(output, writes(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, previous),
        previous, cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, previous), index,
        cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(index)),
        below, room,
        at => Equal.cong(Nat, F32, position => cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, position),
          previous, U32.to_nat(index), Equal.sym(Nat, U32.to_nat(index), previous, at)),
        earlier => writes_value(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, output, previous, index, earlier,
          Conversion.le_predecessor(previous, Shape.logical_numel(Shape.dimensions(output)), room)),
        Shape.bool_case(Nat.is_eq(U32.to_nat(index), previous)))

def lt_not_eq(+a: Nat, +b: Nat, below: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_eq(a, b) == False{} : Bool}:
  match a b:
    case 0n 0n:
      Empty.absurd({Nat.is_eq(0n, 0n) == False{} : Bool}, Arith.clash(below))
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      lt_not_eq(p, q, below)

# A write at an index below `index` leaves the word at `index`.
def write_skip(+shape: Shape.Shape, +previous: Nat, +index: U32, +word: F32, +old: F32,
  +room: {Nat.is_lt(previous, Shape.logical_numel(Shape.dimensions(shape))) == True{} : Bool},
  later: {Nat.is_lt(previous, U32.to_nat(index)) == True{} : Bool}) ->
  {StorageLaws.latest(U32.to_nat(Shape.count(shape)), StorageLaws.Write{U32.from_nat(previous), word}, index, old) == old : F32}:
  %Equal.sym(Nat, U32.to_nat(U32.from_nat(previous)), previous, MatrixIndex.word_exact(previous, shape, room)) :
    {Bool.pick(F32, Bool.and(Nat.is_lt(_, U32.to_nat(Shape.count(shape))), Nat.is_eq(_, U32.to_nat(index))), word, old) == old : F32}
  %Equal.sym(Bool, Nat.is_lt(previous, U32.to_nat(Shape.count(shape))), True{}, PointwiseProof.lt_count(previous, shape, room)) :
    {Bool.pick(F32, Bool.and(_, Nat.is_eq(previous, U32.to_nat(index))), word, old) == old : F32}
  %Equal.sym(Bool, Nat.is_eq(previous, U32.to_nat(index)), False{}, lt_not_eq(previous, U32.to_nat(index), later)) :
    {Bool.pick(F32, _, word, old) == old : F32}
  {==}

# At or above the count, the writes leave the +0.0 fill.
def writes_zero(+lo: Matrix.Order, +ro: Matrix.Order, +inner: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>,
  +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +output: Shape.Shape, +count: Nat, +index: U32,
  +above: {Nat.is_le(count, U32.to_nat(index)) == True{} : Bool},
  +room: {Nat.is_le(count, Shape.logical_numel(Shape.dimensions(output))) == True{} : Bool}) ->
  {Replayed.value(output, 0.0, writes(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count), index) == 0.0 : F32}:
  match count:
    case 0n:
      {==}
    case 1n+previous:
      +history = writes(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, previous)
      +word = cell_word(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, previous)
      +op = {StorageLaws.Write{U32.from_nat(previous), word} : StorageLaws.Op}
      Equal.trans(F32, Replayed.value(output, 0.0, Replayed.snoc(history, op), index),
        StorageLaws.latest(U32.to_nat(Shape.count(output)), op, index, Replayed.value(output, 0.0, history, index)), 0.0,
        Replayed.expected_snoc(history, op, U32.to_nat(Shape.count(output)), index, 0.0),
        Equal.trans(F32, StorageLaws.latest(U32.to_nat(Shape.count(output)), op, index, Replayed.value(output, 0.0, history, index)),
          Replayed.value(output, 0.0, history, index), 0.0,
          write_skip(output, previous, index, word, Replayed.value(output, 0.0, history, index),
            Conversion.le_successor_lt(previous, Shape.logical_numel(Shape.dimensions(output)), room),
            Conversion.le_successor_lt(previous, U32.to_nat(index), above)),
          writes_zero(lo, ro, inner, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, output, previous, index,
            Conversion.le_predecessor(previous, U32.to_nat(index), above),
            Conversion.le_predecessor(previous, Shape.logical_numel(Shape.dimensions(output)), room))))

def lt_zero_false(+x: Nat) -> {Nat.is_lt(x, 0n) == False{} : Bool}:
  match x:
    case 0n:
      {==}
    case 1n+p:
      {==}

def lt_self_succ(+k: Nat) -> {Nat.is_lt(k, 1n+k) == True{} : Bool}:
  match k:
    case 0n:
      {==}
    case 1n+p:
      lt_self_succ(p)

def lt_succ_right(+b: Nat, +k: Nat, h: {Nat.is_lt(b, k) == True{} : Bool}) -> {Nat.is_lt(b, 1n+k) == True{} : Bool}:
  match b k:
    case 0n _:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(1n+p, 1n) == True{} : Bool}, Arith.clash(h))
    case 1n+p 1n+q:
      lt_succ_right(p, q, h)

# k < b gives b < 1 + k false.
def above_false(+k: Nat, +b: Nat, h: {Nat.is_lt(k, b) == True{} : Bool}) -> {Nat.is_lt(b, 1n+k) == False{} : Bool}:
  match k b:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(0n, 1n) == False{} : Bool}, Arith.clash(h))
    case 0n 1n+q:
      lt_zero_false(q)
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(0n, 1n+(1n+p)) == False{} : Bool}, Arith.clash(h))
    case 1n+p 1n+q:
      above_false(p, q, h)

def lt_asym(+k: Nat, +b: Nat, h: {Nat.is_lt(k, b) == True{} : Bool}) -> {Nat.is_lt(b, k) == False{} : Bool}:
  match k b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(0n, 1n+p) == False{} : Bool}, Arith.clash(h))
    case 1n+p 1n+q:
      lt_asym(p, q, h)

# 1 + b <= k gives b < k.
def below_true(+b: Nat, +k: Nat, h: {Nat.is_le(1n+b, k) == True{} : Bool}) -> {Nat.is_lt(b, k) == True{} : Bool}:
  match b k:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(0n, 0n) == True{} : Bool}, Arith.clash(h))
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(1n+p, 0n) == True{} : Bool}, Arith.clash(h))
    case 1n+p 1n+q:
      below_true(p, q, h)

def lt_add_right(+a: Nat, +c: Nat, +b: Nat, h: {Nat.is_lt(a, c) == True{} : Bool}) ->
  {Nat.is_lt(Nat.add(a, b), Nat.add(c, b)) == True{} : Bool}:
  match a c:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(b, b) == True{} : Bool}, Arith.clash(h))
    case 0n 1n+q:
      Arith.lt_succ(b, Nat.add(q, b), Api.le_add_left(q, b))
    case 1n+p 0n:
      Empty.absurd({Nat.is_lt(1n+Nat.add(p, b), b) == True{} : Bool}, Arith.clash(h))
    case 1n+p 1n+q:
      lt_add_right(p, q, b, h)

def le_add_cong(+c: Nat, +x: Nat, +y: Nat, h: {Nat.is_le(x, y) == True{} : Bool}) ->
  {Nat.is_le(Nat.add(c, x), Nat.add(c, y)) == True{} : Bool}:
  match c:
    case 0n:
      h
    case 1n+r:
      le_add_cong(r, x, y, h)

def le_trans(+a: Nat, +b: Nat, +c: Nat, ab: {Nat.is_le(a, b) == True{} : Bool}, bc: {Nat.is_le(b, c) == True{} : Bool}) ->
  {Nat.is_le(a, c) == True{} : Bool}:
  match a b c:
    case 0n _ _:
      Arith.le_zero(c)
    case 1n+p 0n _:
      Empty.absurd({Nat.is_le(1n+p, c) == True{} : Bool}, Arith.clash(ab))
    case 1n+p 1n+q 0n:
      Empty.absurd({Nat.is_le(1n+p, 0n) == True{} : Bool}, Arith.clash(bc))
    case 1n+p 1n+q 1n+r:
      le_trans(p, q, r, ab, bc)

def position_step(+capacity: Nat, +offset: Nat, +base: Nat) ->
  {Nat.add(offset, Nat.add(capacity, base)) == Nat.add(Nat.add(capacity, offset), base) : Nat}:
  Equal.trans(Nat, Nat.add(offset, Nat.add(capacity, base)), Nat.add(capacity, Nat.add(offset, base)), Nat.add(Nat.add(capacity, offset), base),
    Nats.add_swap(offset, capacity, base), Index.add_assoc(capacity, offset, base))

def add_zero_right(+number: Nat) -> {Nat.add(number, 0n) == number : Nat}:
  match number:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, 0n), p, add_zero_right(p))

# A word index below the storage length is the offset of its own route.
def output_position(+depth: Nat, +length: Nat, +index: U32, +valid: {Storage.bounds(depth, length) == True{} : Bool},
  +inside: {Nat.is_lt(U32.to_nat(index), length) == True{} : Bool}) ->
  {Nat.add(Model.offset(depth, Refinement.route(depth, index)), 0n) == U32.to_nat(index) : Nat}:
  +rest = Arith.and_right(Nat.is_le(depth, 20n), Bool.and(Nat.is_lt(0n, length), Nat.is_le(length, Model.capacity(depth))), valid)
  Equal.trans(Nat, Nat.add(Model.offset(depth, Refinement.route(depth, index)), 0n), Model.offset(depth, Refinement.route(depth, index)), U32.to_nat(index),
    add_zero_right(Model.offset(depth, Refinement.route(depth, index))),
    Equal.sym(Nat, U32.to_nat(index), Model.offset(depth, Refinement.route(depth, index)),
      Route.route_offset(depth, index,
        Arith.and_left(Nat.is_le(depth, 20n), Bool.and(Nat.is_lt(0n, length), Nat.is_le(length, Model.capacity(depth))), valid),
        Arith.lt_le_trans(U32.to_nat(index), length, Model.capacity(depth), inside,
          Arith.and_right(Nat.is_lt(0n, length), Nat.is_le(length, Model.capacity(depth)), rest)))))


# The output spec: cell `base` of the tree holds the cell's word below
# `count` and +0.0 above it.

def out_leaf(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +position: Nat, inside: Bool) -> F32:
  match inside:
    case False{}:
      0.0
    case True{}:
      cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, position)

def out_spec(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +count: Nat, +depth: Nat, +base: Nat) -> Array<F32>:
  match depth:
    case 0n:
      ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base, Nat.is_lt(base, count))}
    case 1n+inner:
      ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, inner, base), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, inner, Nat.add(Model.capacity(inner), base))}

def out_balanced(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +count: Nat, +depth: Nat, +base: Nat) -> Model.Balanced(F32, depth, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, depth, base)):
  match depth:
    case 0n:
      Unit{}
    case 1n+inner:
      (out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, inner, base), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, inner, Nat.add(Model.capacity(inner), base)))

def new_spec(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +depth: Nat, +base: Nat) -> {Array.new(F32, depth, 0.0) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, depth, base) : Array<F32>}:
  match depth:
    case 0n:
      %Equal.sym(Bool, Nat.is_lt(base, 0n), False{}, lt_zero_false(base)) :
        {ALeaf{0.0} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base, _)} : Array<F32>}
      {==}
    case 1n+inner:
      %Equal.sym(Array<F32>, Array.new(F32, inner, 0.0), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, inner, base), new_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, inner, base)) :
        {ANode{_, Array.new(F32, inner, 0.0)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, 1n+inner, base) : Array<F32>}
      %Equal.sym(Array<F32>, Array.new(F32, inner, 0.0), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, inner, Nat.add(Model.capacity(inner), base)),
        new_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, inner, Nat.add(Model.capacity(inner), base))) :
        {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, inner, base), _} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, 1n+inner, base) : Array<F32>}
      {==}

# A subtree whose positions all lie above k is the same for k and 1 + k.
def above(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +k: Nat, +depth: Nat, +b: Nat, +h: {Nat.is_lt(k, b) == True{} : Bool}) ->
  {out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, depth, b) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, depth, b) : Array<F32>}:
  match depth:
    case 0n:
      %Equal.sym(Bool, Nat.is_lt(b, k), False{}, lt_asym(k, b, h)) :
        {ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b, _)} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b, Nat.is_lt(b, 1n+k))} : Array<F32>}
      %Equal.sym(Bool, Nat.is_lt(b, 1n+k), False{}, above_false(k, b, h)) :
        {ALeaf{0.0} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b, _)} : Array<F32>}
      {==}
    case 1n+inner:
      +high = Nat.add(Model.capacity(inner), b)
      %Equal.sym(Array<F32>, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, b), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, b), above(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, b, h)) :
        {ANode{_, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, b) : Array<F32>}
      %Equal.sym(Array<F32>, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, high),
        above(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high, Arith.lt_le_trans(k, b, high, h, Api.le_add_left(Model.capacity(inner), b)))) :
        {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, b), _} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, b) : Array<F32>}
      {==}

# A subtree whose positions all lie below k is the same for k and 1 + k.
def below(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +k: Nat, +depth: Nat, +b: Nat, +h: {Nat.is_le(Nat.add(Model.capacity(depth), b), k) == True{} : Bool}) ->
  {out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, depth, b) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, depth, b) : Array<F32>}:
  match depth:
    case 0n:
      +lower = below_true(b, k, h)
      %Equal.sym(Bool, Nat.is_lt(b, k), True{}, lower) :
        {ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b, _)} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b, Nat.is_lt(b, 1n+k))} : Array<F32>}
      %Equal.sym(Bool, Nat.is_lt(b, 1n+k), True{}, lt_succ_right(b, k, lower)) :
        {ALeaf{cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b)} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, b, _)} : Array<F32>}
      {==}
    case 1n+inner:
      +c = Model.capacity(inner)
      +high = Nat.add(c, b)
      +nested = Equal.trans(Bool, Nat.is_le(Nat.add(c, high), k), Nat.is_le(Nat.add(Nat.add(c, c), b), k), True{},
        Equal.cong(Nat, Bool, x => Nat.is_le(x, k), Nat.add(c, high), Nat.add(Nat.add(c, c), b), Index.add_assoc(c, c, b)), h)
      +low_h = le_trans(high, Nat.add(c, high), k, le_add_cong(c, b, high, Api.le_add_left(c, b)), nested)
      %Equal.sym(Array<F32>, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, b), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, b), below(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, b, low_h)) :
        {ANode{_, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, b) : Array<F32>}
      %Equal.sym(Array<F32>, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, high), below(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high, nested)) :
        {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, b), _} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, b) : Array<F32>}
      {==}

# Writing cell k at the path whose position is k turns the spec for k into
# the spec for 1 + k.
def write_spec(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +k: Nat, +depth: Nat, +base: Nat, +path: Model.Path(depth),
  +h: {Nat.add(Model.offset(depth, path), base) == k : Nat}) ->
  {ArrayCore.write_path(F32, depth, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, depth, base), path, cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k)) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, depth, base) : Array<F32>}:
  match depth:
    case 0n:
      %h : {ALeaf{cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, _)} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base, Nat.is_lt(base, 1n+_))} : Array<F32>}
      %Equal.sym(Bool, Nat.is_lt(base, 1n+base), True{}, lt_self_succ(base)) :
        {ALeaf{cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base)} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base, _)} : Array<F32>}
      {==}
    case 1n+inner:
      Model.Step{+bit, +rest} = path
      match bit:
        case False{}:
          +c = Model.capacity(inner)
          +high = Nat.add(c, base)
          +inside = Equal.trans(Bool, Nat.is_lt(k, high), Nat.is_lt(Nat.add(Model.offset(inner, rest), base), high), True{},
            Equal.cong(Nat, Bool, x => Nat.is_lt(x, high), k, Nat.add(Model.offset(inner, rest), base),
              Equal.sym(Nat, Nat.add(Model.offset(inner, rest), base), k, h)),
            lt_add_right(Model.offset(inner, rest), c, base, Api.offset_lt(inner, rest)))
          %Equal.sym(Array<F32>, ArrayCore.write_path(F32, inner, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, base), rest, cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k)),
            out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, base), write_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, base, rest, h)) :
            {ANode{_, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, base) : Array<F32>}
          %Equal.sym(Array<F32>, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, high), above(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high, inside)) :
            {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, base), _} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, base) : Array<F32>}
          {==}
        case True{}:
          +c = Model.capacity(inner)
          +high = Nat.add(c, base)
          +off = Model.offset(inner, rest)
          +lower = Equal.trans(Bool, Nat.is_le(high, k), Nat.is_le(high, Nat.add(c, Nat.add(off, base))), True{},
            Equal.cong(Nat, Bool, x => Nat.is_le(high, x), k, Nat.add(c, Nat.add(off, base)),
              Equal.trans(Nat, k, Nat.add(Nat.add(c, off), base), Nat.add(c, Nat.add(off, base)),
                Equal.sym(Nat, Nat.add(Nat.add(c, off), base), k, h),
                Equal.sym(Nat, Nat.add(c, Nat.add(off, base)), Nat.add(Nat.add(c, off), base), Index.add_assoc(c, off, base)))),
            le_add_cong(c, base, Nat.add(off, base), Api.le_add_left(off, base)))
          +shifted = Equal.trans(Nat, Nat.add(off, high), Nat.add(Nat.add(c, off), base), k, position_step(c, off, base), h)
          %Equal.sym(Array<F32>, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, base), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, base), below(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, base, lower)) :
            {ANode{_, ArrayCore.write_path(F32, inner, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high), rest, cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k))} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, base) : Array<F32>}
          %Equal.sym(Array<F32>, ArrayCore.write_path(F32, inner, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high), rest, cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k)),
            out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, high), write_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, inner, high, rest, shifted)) :
            {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, inner, base), _} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+k, 1n+inner, base) : Array<F32>}
          {==}

# The family history, replayed on the owned storage that `created` makes,
# is the owned storage that holds the output spec.
def chain(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +d: Nat, +n: Nat, -f: {Storage.bounds(d, n) == True{} : Bool}, +fits: {Storage.bounds(d, n) == True{} : Bool},
  +limit: U32, +n_limit: {Nat.is_le(n, U32.to_nat(limit)) == True{} : Bool},
  +k: Nat, +room: {Nat.is_le(k, n) == True{} : Bool}) ->
  {StorageLaws.replay(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k), Storage.Owned{d, n, Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}) == Storage.Owned{d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, d, 0n), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k, d, 0n), f} : Storage.Storage}:
  match k:
    case 0n:
      Owned.owned_eq(d, n, Array.new(F32, d, 0.0), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, d, 0n), new_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, d, 0n), ArrayCore.new_balanced(F32, d, 0.0), f)(
        out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 0n, d, 0n))
    case 1n+j:
      +index = U32.from_nat(j)
      +value = cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j)
      +below_n = Conversion.le_successor_lt(j, n, room)
      +exact = Conversion.natural_word_exact(j, limit, le_trans(j, n, U32.to_nat(limit), Conversion.lt_le(j, n, below_n), n_limit))
      +inside = Equal.trans(Bool, Nat.is_lt(U32.to_nat(index), n), Nat.is_lt(j, n), True{},
        Equal.cong(Nat, Bool, x => Nat.is_lt(x, n), U32.to_nat(index), j, exact), below_n)
      +offset = Equal.trans(Nat, Nat.add(Model.offset(d, Refinement.route(d, index)), 0n), U32.to_nat(index), j,
        output_position(d, n, index, fits, inside), exact)
      +written = Equal.trans(Array<F32>, Array.set(F32, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value), ArrayCore.write_path(F32, d, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), Refinement.route(d, index), value),
        out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), Refinement.law_set_refines(F32, d, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value, out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n)),
        write_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n, Refinement.route(d, index), offset))
      Equal.trans(Storage.Storage, StorageLaws.replay(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j), Storage.Owned{d, n, Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}),
        StorageLaws.step(StorageLaws.replay(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j), Storage.Owned{d, n, Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}), StorageLaws.Write{index, value}),
        Storage.Owned{d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), f},
        FromValues.replay_snoc(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j), StorageLaws.Write{index, value}, Storage.Owned{d, n, Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}),
        %Equal.sym(Storage.Storage, StorageLaws.replay(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j), Storage.Owned{d, n, Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}), Storage.Owned{d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), f},
          chain(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, d, n, f, fits, limit, n_limit, j, Conversion.le_predecessor(j, n, room))) :
          {StorageLaws.step(_, StorageLaws.Write{index, value}) == Storage.Owned{d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), f} : Storage.Storage}
        %Equal.sym(Storage.Storage & Result<&2, &2, Storage.Error, Unit>,
          Storage.set_checked(d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value, Nat.is_lt(U32.to_nat(index), n), {==}, out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), f),
          (Storage.Owned{d, n, Array.set(F32, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value),
            Certificates.set_result(F32, d, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value, Array.set(F32, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value), {==}, out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n)), f}, Done{Unit{}}),
          Api.set_checked_hit(d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value, Nat.is_lt(U32.to_nat(index), n), {==}, out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), f,
            Equal.sym(Bool, Nat.is_lt(U32.to_nat(index), n), True{}, inside), fits, inside)) :
          {StorageLaws.owner(Result<&2, &2, Storage.Error, Unit>, _) == Storage.Owned{d, n, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), f} : Storage.Storage}
        Owned.owned_eq(d, n, Array.set(F32, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n), written,
          Certificates.set_result(F32, d, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value, Array.set(F32, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n), index, value), {==}, out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, j, d, 0n)), f)(
          out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, 1n+j, d, 0n)))


# The copy the build reads of a replayed input in normal form: the Second
# half of the clone of the array its normalized history makes.
def history(+shape: Shape.Shape, +ops: List<&2, StorageLaws.Op>) -> List<&2, Api.Effect>:
  Api.Right{} <> Owned.norm(U32.to_nat(Shape.count(shape)), ops, Nil{})

def copy(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, +depth: Nat) -> Array<F32>:
  Api.arr(history(shape, ops), depth, fill)

def copy_valid(+shape: Shape.Shape, +ops: List<&2, StorageLaws.Op>) -> {Build.written(U32.to_nat(Shape.count(shape)), history(shape, ops)) == True{} : Bool}:
  Owned.norm_written(U32.to_nat(Shape.count(shape)), ops, Nil{}, Api.hit_of(U32.to_nat(Shape.count(shape)), ops), {==}, {==})

# A read of the copy below the input's count holds the replayed word.
def copy_word(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, +index: U32) ->
  {Api.current(history(shape, ops), index, fill) == Replayed.value(shape, fill, ops, index) : F32}:
  Owned.norm_current(U32.to_nat(Shape.count(shape)), ops, Nil{}, index, fill, Api.hit_of(U32.to_nat(Shape.count(shape)), ops), {==})

def index_inside(+shape: Shape.Shape, +number: Nat, +below: {Nat.is_lt(number, Shape.logical_numel(Shape.dimensions(shape))) == True{} : Bool}) ->
  {Nat.is_lt(U32.to_nat(U32.from_nat(number)), U32.to_nat(Shape.count(shape))) == True{} : Bool}:
  PointwiseProof.lt_count(U32.to_nat(U32.from_nat(number)), shape, MatrixIndex.word_inside(number, shape, below))

# The terms `cursor .. cursor + fuel` of cell (row, column) over the replayed
# words, added to `accumulator` in increasing k.
def fold_from(fuel: Nat, +lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +row: Nat, +column: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>,
  +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +cursor: Nat, accumulator: F32) -> F32:
  match fuel:
    case 0n:
      accumulator
    case 1n+rest:
      fold_from(rest, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 1n+cursor,
        F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)),
          Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))))

def fold_factors(+fuel: Nat, +lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +row: Nat, +column: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>,
  +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +cursor: Nat,
  +steps: {Nat.add(cursor, fuel) == span : Nat}) ->
  {fold_from(fuel, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, cursor,
    DotFold.dot_fold(Laws.product_factors(row, column, lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, cursor), 0.0)) ==
    DotFold.dot_fold(Laws.product_factors(row, column, lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, span), 0.0) : F32}:
  match fuel:
    case 0n:
      Equal.cong(Nat, F32,
        k => DotFold.dot_fold(Laws.product_factors(row, column, lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, k), 0.0),
        cursor, span, PointwiseProof.steps_done(cursor, span, steps))
    case 1n+rest:
      +x = Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor))
      +y = Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor))
      +before = Laws.product_factors(row, column, lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, cursor)
      %DotProof.dot_snoc(before, x, y, 0.0) :
        {fold_from(rest, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 1n+cursor, _) ==
          DotFold.dot_fold(Laws.product_factors(row, column, lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, span), 0.0) : F32}
      fold_factors(rest, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 1n+cursor,
        MatrixIndex.steps_next(cursor, rest, span, steps))


# How a build copy answers the reads of its input: an empty input has no
# cell to read, and a normal one holds the input's normalized history.
type Source<-shape: Shape.Shape, -fill: F32, -ops: List<&2, StorageLaws.Op>, -h: List<&2, Api.Effect>, -d: Nat, -f: F32> is Data:
  NoCells{zero: {U32.to_nat(Shape.count(shape)) == 0n : Nat}}
  Normal{fits: {Storage.bounds(d, U32.to_nat(Shape.count(shape))) == True{} : Bool},
    same: {h == history(shape, ops) : List<&2, Api.Effect>}, filled: {f == fill : F32}}

def source_read(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, +h: List<&2, Api.Effect>, +d: Nat, +f: F32,
  +source: Source<shape, fill, ops, h, d, f>, +index: U32,
  +inside: {Nat.is_lt(U32.to_nat(index), U32.to_nat(Shape.count(shape))) == True{} : Bool}, -pair: Array<F32> & F32,
  +exact: {pair == Array.get(F32, Api.arr(h, d, f), index) : Array<F32> & F32}) ->
  {Refinement.second(F32, pair) == Replayed.value(shape, fill, ops, index) : F32}:
  match source:
    case NoCells{zero}:
      Empty.absurd({Refinement.second(F32, pair) == Replayed.value(shape, fill, ops, index) : F32},
        Arith.lt_zero(U32.to_nat(index),
          %zero : {Nat.is_lt(U32.to_nat(index), _) == True{} : Bool}
          inside))
    case Normal{fits, same, filled}:
      Equal.trans(F32, Refinement.second(F32, pair), Api.current(h, index, f), Replayed.value(shape, fill, ops, index),
        Build.got_value(d, h, f, U32.to_nat(Shape.count(shape)), index, pair, exact, fits, inside,
          %Equal.sym(List<&2, Api.Effect>, h, history(shape, ops), same) : {Build.written(U32.to_nat(Shape.count(shape)), _) == True{} : Bool}
          copy_valid(shape, ops)),
        %Equal.sym(List<&2, Api.Effect>, h, history(shape, ops), same) : {Api.current(_, index, f) == Replayed.value(shape, fill, ops, index) : F32}
        %Equal.sym(F32, f, fill, filled) : {Api.current(history(shape, ops), index, _) == Replayed.value(shape, fill, ops, index) : F32}
        copy_word(shape, fill, ops, index))

def DotIs(+fuel: Nat, +lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +row: Nat, +column: Nat, +cursor: Nat, +accumulator: F32,
  -result: F32 & (Array<F32> & Array<F32>)) -> Type:
  {result == (fold_from(fuel, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, cursor, accumulator), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))) : F32 & (Array<F32> & Array<F32>)}

# Each offset steps by its operand's stride: the term after term k of an
# operand in `order` sits at read_offset of k + 1.
def stepped(+order: Matrix.Order, +inner: Nat, +outers: Nat, +outer: Nat, +k: Nat) ->
  {Nat.add(Matrix.stride(order, outers), Matrix.read_offset(order, inner, outers, outer, k)) ==
    Matrix.read_offset(order, inner, outers, outer, 1n+k) : Nat}:
  match order:
    case Matrix.Kept{}:
      Equal.sym(Nat, Nat.add(Nat.mul(outer, inner), 1n+k), 1n+Nat.add(Nat.mul(outer, inner), k), Arith.add_succ(Nat.mul(outer, inner), k))
    case Matrix.Swapped{}:
      Index.add_assoc(outers, Nat.mul(k, outers), outer)

# The last term of a run: both reads hold the replayed words, and both
# copies come back.
def run_last(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>, +row: Nat, +column: Nat, +cursor: Nat, +accumulator: F32,
  +row_below: {Nat.is_lt(row, rows) == True{} : Bool}, +left_extents: Fits(lo, span, rows, left),
  +column_below: {Nat.is_lt(column, columns) == True{} : Bool}, +right_extents: Fits(ro, span, columns, right),
  +below: {Nat.is_lt(cursor, span) == True{} : Bool},
  pl: Array<F32> & F32, +exact_l: {pl == Array.get(F32, Api.arr(ha, dl, fa), Matrix.read_index(lo, span, rows, row, cursor)) : Array<F32> & F32},
  pr: Array<F32> & F32, +exact_r: {pr == Array.get(F32, Api.arr(hb, dr, fb), Matrix.read_index(ro, span, columns, column, cursor)) : Array<F32> & F32}) ->
  DotIs(1n, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(0n, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Matrix.read_offset(lo, span, rows, row, cursor), Matrix.read_offset(ro, span, columns, column, cursor), accumulator, pl, pr)):
  (la, x) = pl
  (ra, y) = pr
  +ex = source_read(left, left_fill, left_ops, ha, dl, fa, lsrc, Matrix.read_index(lo, span, rows, row, cursor),
    index_inside(left, Matrix.read_offset(lo, span, rows, row, cursor), read_below(lo, span, rows, row, row_below, left, left_extents, cursor, below)),
    (la, x), exact_l)
  +ey = source_read(right, right_fill, right_ops, hb, dr, fb, rsrc, Matrix.read_index(ro, span, columns, column, cursor),
    index_inside(right, Matrix.read_offset(ro, span, columns, column, cursor), read_below(ro, span, columns, column, column_below, right, right_extents, cursor, below)),
    (ra, y), exact_r)
  +el = Build.got_kept(dl, ha, fa, Matrix.read_index(lo, span, rows, row, cursor), (la, x), exact_l)
  +er = Build.got_kept(dr, hb, fb, Matrix.read_index(ro, span, columns, column, cursor), (ra, y), exact_r)
  %Equal.sym(F32, x, Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), ex) :
    DotIs(1n, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, (F32.add(accumulator, F32.mul(_, y)), (la, ra)))
  %Equal.sym(F32, y, Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)), ey) :
    DotIs(1n, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, (F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), _)), (la, ra)))
  %Equal.sym(Array<F32>, la, Api.arr(ha, dl, fa), el) :
    DotIs(1n, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, (F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), (_, ra)))
  %Equal.sym(Array<F32>, ra, Api.arr(hb, dr, fb), er) :
    DotIs(1n, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, (F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), (Api.arr(ha, dl, fa), _)))
  {==}

# A term with more after it: the reads hold the replayed words, the offsets
# step to the next term's, and the run goes on from its reads of the same
# copies.
def run_next(+rest: Nat, +lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>, +row: Nat, +column: Nat, +cursor: Nat, +accumulator: F32,
  +row_below: {Nat.is_lt(row, rows) == True{} : Bool}, +left_extents: Fits(lo, span, rows, left),
  +column_below: {Nat.is_lt(column, columns) == True{} : Bool}, +right_extents: Fits(ro, span, columns, right),
  +below: {Nat.is_lt(cursor, span) == True{} : Bool},
  pl: Array<F32> & F32, +exact_l: {pl == Array.get(F32, Api.arr(ha, dl, fa), Matrix.read_index(lo, span, rows, row, cursor)) : Array<F32> & F32},
  pr: Array<F32> & F32, +exact_r: {pr == Array.get(F32, Api.arr(hb, dr, fb), Matrix.read_index(ro, span, columns, column, cursor)) : Array<F32> & F32},
  next: DotIs(1n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, 1n+cursor, F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Matrix.read_offset(lo, span, rows, row, 1n+cursor), Matrix.read_offset(ro, span, columns, column, 1n+cursor), F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), Array.get(F32, Api.arr(ha, dl, fa), Matrix.read_index(lo, span, rows, row, 1n+cursor)), Array.get(F32, Api.arr(hb, dr, fb), Matrix.read_index(ro, span, columns, column, 1n+cursor))))) ->
  DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(1n+rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Matrix.read_offset(lo, span, rows, row, cursor), Matrix.read_offset(ro, span, columns, column, cursor), accumulator, pl, pr)):
  (la, x) = pl
  (ra, y) = pr
  +ex = source_read(left, left_fill, left_ops, ha, dl, fa, lsrc, Matrix.read_index(lo, span, rows, row, cursor),
    index_inside(left, Matrix.read_offset(lo, span, rows, row, cursor), read_below(lo, span, rows, row, row_below, left, left_extents, cursor, below)),
    (la, x), exact_l)
  +ey = source_read(right, right_fill, right_ops, hb, dr, fb, rsrc, Matrix.read_index(ro, span, columns, column, cursor),
    index_inside(right, Matrix.read_offset(ro, span, columns, column, cursor), read_below(ro, span, columns, column, column_below, right, right_extents, cursor, below)),
    (ra, y), exact_r)
  +el = Build.got_kept(dl, ha, fa, Matrix.read_index(lo, span, rows, row, cursor), (la, x), exact_l)
  +er = Build.got_kept(dr, hb, fb, Matrix.read_index(ro, span, columns, column, cursor), (ra, y), exact_r)
  %Equal.sym(F32, x, Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), ex) :
    DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)), Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor)), F32.add(accumulator, F32.mul(_, y)), Array.get(F32, la, U32.from_nat(Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)))), Array.get(F32, ra, U32.from_nat(Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor))))))
  %Equal.sym(F32, y, Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)), ey) :
    DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)), Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor)), F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), _)), Array.get(F32, la, U32.from_nat(Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)))), Array.get(F32, ra, U32.from_nat(Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor))))))
  %Equal.sym(Array<F32>, la, Api.arr(ha, dl, fa), el) :
    DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)), Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor)), F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), Array.get(F32, _, U32.from_nat(Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)))), Array.get(F32, ra, U32.from_nat(Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor))))))
  %Equal.sym(Array<F32>, ra, Api.arr(hb, dr, fb), er) :
    DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)), Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor)), F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), Array.get(F32, Api.arr(ha, dl, fa), U32.from_nat(Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)))), Array.get(F32, _, U32.from_nat(Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor))))))
  %Equal.sym(Nat, Nat.add(Matrix.stride(lo, rows), Matrix.read_offset(lo, span, rows, row, cursor)), Matrix.read_offset(lo, span, rows, row, 1n+cursor), stepped(lo, span, rows, row, cursor)) :
    DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), _, Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor)), F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), Array.get(F32, Api.arr(ha, dl, fa), U32.from_nat(_)), Array.get(F32, Api.arr(hb, dr, fb), U32.from_nat(Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor))))))
  %Equal.sym(Nat, Nat.add(Matrix.stride(ro, columns), Matrix.read_offset(ro, span, columns, column, cursor)), Matrix.read_offset(ro, span, columns, column, 1n+cursor), stepped(ro, span, columns, column, cursor)) :
    DotIs(2n+rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(rest, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Matrix.read_offset(lo, span, rows, row, 1n+cursor), _, F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), Array.get(F32, Api.arr(ha, dl, fa), U32.from_nat(Matrix.read_offset(lo, span, rows, row, 1n+cursor))), Array.get(F32, Api.arr(hb, dr, fb), U32.from_nat(_))))
  next

# A run of fuel + 1 terms from cursor folds the replayed words in increasing
# k and hands both copies back.
def run_eq(+fuel: Nat, +lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>, +row: Nat, +column: Nat, +cursor: Nat, +accumulator: F32,
  +row_below: {Nat.is_lt(row, rows) == True{} : Bool}, +left_extents: Fits(lo, span, rows, left),
  +column_below: {Nat.is_lt(column, columns) == True{} : Bool}, +right_extents: Fits(ro, span, columns, right),
  +steps: {Nat.add(cursor, 1n+fuel) == span : Nat},
  pl: Array<F32> & F32, +exact_l: {pl == Array.get(F32, Api.arr(ha, dl, fa), Matrix.read_index(lo, span, rows, row, cursor)) : Array<F32> & F32},
  pr: Array<F32> & F32, +exact_r: {pr == Array.get(F32, Api.arr(hb, dr, fb), Matrix.read_index(ro, span, columns, column, cursor)) : Array<F32> & F32}) ->
  DotIs(1n+fuel, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_run(fuel, Matrix.stride(lo, rows), Matrix.stride(ro, columns), Matrix.read_offset(lo, span, rows, row, cursor), Matrix.read_offset(ro, span, columns, column, cursor), accumulator, pl, pr)):
  match fuel:
    case 0n:
      run_last(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, lsrc, rsrc, row, column, cursor, accumulator, row_below, left_extents, column_below, right_extents, MatrixIndex.cursor_below(cursor, 0n, span, steps), pl, exact_l, pr, exact_r)
    case 1n+rest:
      run_next(rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, lsrc, rsrc, row, column, cursor, accumulator, row_below, left_extents, column_below, right_extents, MatrixIndex.cursor_below(cursor, 1n+rest, span, steps), pl, exact_l, pr, exact_r,
        run_eq(rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, lsrc, rsrc, row, column, 1n+cursor, F32.add(accumulator, F32.mul(Replayed.value(left, left_fill, left_ops, Matrix.read_index(lo, span, rows, row, cursor)), Replayed.value(right, right_fill, right_ops, Matrix.read_index(ro, span, columns, column, cursor)))), row_below, left_extents, column_below, right_extents, MatrixIndex.steps_next(cursor, 1n+rest, span, steps),
          Array.get(F32, Api.arr(ha, dl, fa), Matrix.read_index(lo, span, rows, row, 1n+cursor)), {==}, Array.get(F32, Api.arr(hb, dr, fb), Matrix.read_index(ro, span, columns, column, 1n+cursor)), {==}))

# Cell (row, column) of the build over the two copies folds the replayed
# words in increasing k and hands both copies back.
def dot_eq(+fuel: Nat, +lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>, +row: Nat, +column: Nat, +cursor: Nat, +accumulator: F32,
  +row_below: {Nat.is_lt(row, rows) == True{} : Bool}, +left_extents: Fits(lo, span, rows, left),
  +column_below: {Nat.is_lt(column, columns) == True{} : Bool}, +right_extents: Fits(ro, span, columns, right), +steps: {Nat.add(cursor, fuel) == span : Nat}) ->
  DotIs(fuel, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, row, column, cursor, accumulator, Matrix.product_dot(fuel, lo, ro, span, rows, columns, row, column, cursor, accumulator, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))):
  match fuel:
    case 0n:
      {==}
    case 1n+rest:
      run_eq(rest, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, lsrc, rsrc, row, column, cursor, accumulator, row_below, left_extents, column_below, right_extents, steps, Array.get(F32, Api.arr(ha, dl, fa), Matrix.read_index(lo, span, rows, row, cursor)), {==}, Array.get(F32, Api.arr(hb, dr, fb), Matrix.read_index(ro, span, columns, column, cursor)), {==})

def TreeEq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +depth: Nat, +base: Nat, -result: Array<F32> & (Array<F32> & Array<F32>)) -> Type:
  {Pair.fst(Array<F32>, Array<F32> & Array<F32>, result) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, depth, base) : Array<F32>} &
    ({Pair.fst(Array<F32>, Array<F32>, Pair.snd(Array<F32>, Array<F32> & Array<F32>, result)) == Api.arr(ha, dl, fa) : Array<F32>} &
      {Pair.snd(Array<F32>, Array<F32>, Pair.snd(Array<F32>, Array<F32> & Array<F32>, result)) == Api.arr(hb, dr, fb) : Array<F32>})

def cell_inside_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +base: Nat,
  +decided: {True{} == Nat.is_lt(base, count) : Bool}) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 0n, base, Parallel.leaf(~(Array<F32> & Array<F32>), Matrix.product_cell(lo, ro, span, rows, columns, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb), True{}))):
  +row = Matrix.row_of(columns, base)
  +column = Matrix.column_of(columns, base)
  +below = MatrixIndex.lt_bound(base, count, Shape.logical_numel(Shape.dimensions(output)), count_exact,
    Equal.sym(Bool, True{}, Nat.is_lt(base, count), decided))
  +fit = MatrixIndex.position_fits(output, rows, columns, output_extents, base, below)
  +row_below = Arith.and_left(Nat.is_lt(row, rows), Bool.and(Nat.is_lt(column, columns), True{}), fit)
  +column_below = Arith.and_left(Nat.is_lt(column, columns), True{},
    Arith.and_right(Nat.is_lt(row, rows), Bool.and(Nat.is_lt(column, columns), True{}), fit))
  %Equal.sym(F32 & (Array<F32> & Array<F32>),
    Matrix.product_dot_of(lo, ro, span, rows, columns, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)),
    (fold_from(span, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))),
    dot_eq(span, lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, lsrc, rsrc, row, column, 0n, 0.0, row_below, left_extents, column_below, right_extents, {==})) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 0n, base, Parallel.leaf(~(Array<F32> & Array<F32>), _))
  (%decided : {ALeaf{fold_from(span, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0)} ==
      ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base, _)} : Array<F32>}
    Equal.cong(F32, Array<F32>, w => ALeaf{w},
      fold_from(span, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0),
      cell_word(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base),
      fold_factors(span, lo, ro, span, rows, columns, row, column, left, left_fill, left_ops, right, right_fill, right_ops, 0n, {==})),
   ({==}, {==}))

def cell_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +base: Nat, inside: Bool,
  +decided: {inside == Nat.is_lt(base, count) : Bool}) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 0n, base, Parallel.leaf(~(Array<F32> & Array<F32>), Matrix.product_cell(lo, ro, span, rows, columns, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb), inside))):
  match inside:
    case False{}:
      (%decided : {ALeaf{0.0} == ALeaf{out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, base, _)} : Array<F32>}
       {==}, ({==}, {==}))
    case True{}:
      cell_inside_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, base, decided)

def tree_join_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lower: Nat, +base: Nat, -a: Array<F32>, high: Array<F32> & (Array<F32> & Array<F32>),
  ea: {a == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base) : Array<F32>},
  facts: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, Nat.add(Model.capacity(lower), base), high)) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.join(~(Array<F32> & Array<F32>), a, high)):
  (b, inputs) = high
  (eb, kept) = facts
  (%Equal.sym(Array<F32>, a, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base), ea) :
     {ANode{_, b} == ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, Nat.add(Model.capacity(lower), base))} : Array<F32>}
   %Equal.sym(Array<F32>, b, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, Nat.add(Model.capacity(lower), base)), eb) :
     {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base), _} == ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, Nat.add(Model.capacity(lower), base))} : Array<F32>}
   {==}, kept)

def tree_node_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lower: Nat, +base: Nat, low: Array<F32> & (Array<F32> & Array<F32>),
  facts: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, base, low),
  next: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, Nat.add(Model.capacity(lower), base), Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), lower, count, Nat.add(Model.capacity(lower), base), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))))) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.node(~Array<F32>, ~Array<F32>, l => r => Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), lower, count, Nat.add(Model.capacity(lower), base), (l, r)), low)):
  (a, inputs) = low
  (la, ra) = inputs
  (ea, kept) = facts
  (el, er) = kept
  %Equal.sym(Array<F32>, la, Api.arr(ha, dl, fa), el) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.join(~(Array<F32> & Array<F32>), a, Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), lower, count, Nat.add(Model.capacity(lower), base), (_, ra))))
  %Equal.sym(Array<F32>, ra, Api.arr(hb, dr, fb), er) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.join(~(Array<F32> & Array<F32>), a, Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), lower, count, Nat.add(Model.capacity(lower), base), (Api.arr(ha, dl, fa), _))))
  tree_join_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, base, a, Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), lower, count, Nat.add(Model.capacity(lower), base), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))), ea, next)

# The depth-1 tree: the leaf of cell `base` and the leaf of the cell after
# it, which reads the state the first hands back.
def pair_join_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +base: Nat, x: F32, high: F32 & Array<F32> & Array<F32>,
  ex: {ALeaf{x} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, base) : Array<F32>},
  leaf_facts: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 0n, Nat.add(1n, base), Parallel.leaf(~(Array<F32> & Array<F32>), high))) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n, base, Parallel.pair_join(~(Array<F32> & Array<F32>), x, high)):
  (y, inputs) = high
  (ey, kept) = leaf_facts
  (%Equal.sym(Array<F32>, ALeaf{x}, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, base), ex) : {ANode{_, ALeaf{y}} == ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, base), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, Nat.add(1n, base))} : Array<F32>}
   %Equal.sym(Array<F32>, ALeaf{y}, out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, Nat.add(1n, base)), ey) : {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, base), _} == ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, base), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 0n, Nat.add(1n, base))} : Array<F32>}
   {==}, kept)

def pair_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +base: Nat, low: F32 & Array<F32> & Array<F32>,
  leaf_facts: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 0n, base, Parallel.leaf(~(Array<F32> & Array<F32>), low))) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n, base, Parallel.pair(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), count, base, low)):
  (x, inputs) = low
  (la, ra) = inputs
  (ex, kept) = leaf_facts
  (el, er) = kept
  %Equal.sym(Array<F32>, la, Api.arr(ha, dl, fa), el) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n, base, Parallel.pair_join(~(Array<F32> & Array<F32>), x, Matrix.product_cell_at(Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), Nat.add(1n, base), (_, ra), Nat.is_lt(Nat.add(1n, base), count))))
  %Equal.sym(Array<F32>, ra, Api.arr(hb, dr, fb), er) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n, base, Parallel.pair_join(~(Array<F32> & Array<F32>), x, Matrix.product_cell_at(Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), Nat.add(1n, base), (Api.arr(ha, dl, fa), _), Nat.is_lt(Nat.add(1n, base), count))))
  pair_join_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, base, x, Matrix.product_cell_at(Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), Nat.add(1n, base), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), Nat.is_lt(Nat.add(1n, base), count)), ex,
    cell_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, Nat.add(1n, base), Nat.is_lt(Nat.add(1n, base), count), {==}))

def tree_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +depth: Nat, +base: Nat) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, depth, base, Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), depth, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)))):
  match depth:
    case 0n:
      cell_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, base, Nat.is_lt(base, count), {==})
    case 1n+lower:
      match lower:
        case 0n:
          pair_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, base, Matrix.product_cell_at(Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), Nat.is_lt(base, count)),
            cell_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, base, Nat.is_lt(base, count), {==}))
        case 1n+below:
          tree_node_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, base, Parallel.tree(~Matrix.Layout, ~Array<F32>, ~Array<F32>, ~Matrix.product_cell_at, Matrix.layout(Matrix.Layout{lo, ro, span, rows, columns}), lower, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))),
            tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, lower, base),
            tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, lower, Nat.add(Model.capacity(lower), base)))

def tree_first(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +depth: Nat, +base: Nat, -result: Array<F32> & (Array<F32> & Array<F32>), facts: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, depth, base, result)) ->
  {Pair.fst(Array<F32>, Array<F32> & Array<F32>, result) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, depth, base) : Array<F32>}:
  (first, kept) = facts
  first

# The eight reads of a row run: each holds the replayed word of the right
# input at its offset, and the copy comes back.
def eight_read_8_eq(+right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>, +x0: F32, +x1: F32, +x2: F32, +x3: F32, +x4: F32, +x5: F32, +x6: F32, +o7: Nat, +in7: {Nat.is_lt(U32.to_nat(U32.from_nat(o7)), U32.to_nat(Shape.count(right))) == True{} : Bool},
  pair: Array<F32> & F32, +exact: {pair == Array.get(F32, Api.arr(hb, dr, fb), U32.from_nat(o7)) : Array<F32> & F32}) ->
