  +ea = Build.got_kept(dr, hb, fb, U32.from_nat(o7), (a, x), exact)
  %Equal.sym(F32, x, Replayed.value(right, right_fill, right_ops, U32.from_nat(o7)), ex) :
    {(a, Matrix.Eight{x0, x1, x2, x3, x4, x5, x6, _}) == (Api.arr(hb, dr, fb), Matrix.Eight{x0, x1, x2, x3, x4, x5, x6, Replayed.value(right, right_fill, right_ops, U32.from_nat(o7))}) : Array<F32> & Matrix.Eight}
  %Equal.sym(Array<F32>, a, Api.arr(hb, dr, fb), ea) :
    {(_, Matrix.Eight{x0, x1, x2, x3, x4, x5, x6, Replayed.value(right, right_fill, right_ops, U32.from_nat(o7))}) == (Api.arr(hb, dr, fb), Matrix.Eight{x0, x1, x2, x3, x4, x5, x6, Replayed.value(right, right_fill, right_ops, U32.from_nat(o7))}) : Array<F32> & Matrix.Eight}
