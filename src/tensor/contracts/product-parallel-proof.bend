def block_or_tree_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +base: Nat, one: Bool,
  +decided: {one == Matrix.one_row(Matrix.Layout{lo, ro, span, rows, columns}, count, base) : Bool}) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 3n, base, Matrix.block_or_tree(Matrix.Layout{lo, ro, span, rows, columns}, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), one)):
  match one:
    case False{}:
      tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, 3n, base)
    case True{}:
      row_block_tree(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, base, decided)

# A node of the product tree: both halves walked, as tree_node_eq walks a
# node of the one-thread tree.
def product_node_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lower: Nat, +base: Nat, low: Array<F32> & (Array<F32> & Array<F32>),
  facts: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, base, low),
  next: TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, Nat.add(Model.capacity(lower), base), Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, lower, count, Nat.add(Model.capacity(lower), base), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))))) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.node(~Array<F32>, ~Array<F32>, l => r => Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, lower, count, Nat.add(Model.capacity(lower), base), (l, r)), low)):
  (a, inputs) = low
  (la, ra) = inputs
  (ea, kept) = facts
  (el, er) = kept
  %Equal.sym(Array<F32>, la, Api.arr(ha, dl, fa), el) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.join(~(Array<F32> & Array<F32>), a, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, lower, count, Nat.add(Model.capacity(lower), base), (_, ra))))
  %Equal.sym(Array<F32>, ra, Api.arr(hb, dr, fb), er) :
    TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Parallel.join(~(Array<F32> & Array<F32>), a, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, lower, count, Nat.add(Model.capacity(lower), base), (Api.arr(ha, dl, fa), _))))
  tree_join_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, base, a, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, lower, count, Nat.add(Model.capacity(lower), base), (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))), ea, next)

# The product tree over the copies returns the spec.
def product_tree_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +depth: Nat, +base: Nat) ->
  TreeEq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, depth, base, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, depth, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)))):
  match depth:
    case 0n:
      tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, 0n, base)
    case 1n+d1:
      match d1:
        case 0n:
          tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, 1n, base)
        case 1n+d2:
          match d2:
            case 0n:
              tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, 2n, base)
            case 1n+d3:
              match d3:
                case 0n:
                  block_or_tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, base, Matrix.one_row(Matrix.Layout{lo, ro, span, rows, columns}, count, base), {==})
                case 1n+d4:
                  product_node_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, d1, base, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, d1, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))),
                    product_tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, d1, base),
                    product_tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, d1, Nat.add(Model.capacity(d1), base)))

def fork_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lower: Nat, +rest: Nat, +base: Nat,
  low: {Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base) : Array<F32>},
  high: {Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, Nat.add(Model.capacity(lower), base), Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, Nat.add(Model.capacity(lower), base)) : Array<F32>},
  lp: Array<F32> & Array<F32>, +le: {lp == Array.clone(F32, Api.arr(ha, dl, fa)) : Array<F32> & Array<F32>},
  rp: Array<F32> & Array<F32>, +re: {rp == Array.clone(F32, Api.arr(hb, dr, fb)) : Array<F32> & Array<F32>}) ->
  {Parallel.fork(~Array<F32>, ~Array<F32>, Elementwise.halves(lp, rp), l => r => Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, l, r), l => r => Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, Parallel.upper(lower, base), l, r)) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}:
  (l1, l2) = lp
  (r1, r2) = rp
  +upper = Nat.add(Model.capacity(lower), base)
  %Equal.sym(Array<F32>, l1, Api.arr(ha, dl, fa), Build.clone_first_eq(dl, ha, fa, (l1, l2), le)) :
    {ANode{Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, _, r1), Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, upper, l2, r2)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}
  %Equal.sym(Array<F32>, r1, Api.arr(hb, dr, fb), Build.clone_first_eq(dr, hb, fb, (r1, r2), re)) :
    {ANode{Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, Api.arr(ha, dl, fa), _), Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, upper, l2, r2)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}
  %Equal.sym(Array<F32>, l2, Api.arr(ha, dl, fa), Build.clone_second_eq(dl, ha, fa, (l1, l2), le)) :
    {ANode{Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, upper, _, r2)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}
  %Equal.sym(Array<F32>, r2, Api.arr(hb, dr, fb), Build.clone_second_eq(dr, hb, fb, (r1, r2), re)) :
    {ANode{Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, upper, Api.arr(ha, dl, fa), _)} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}
  %Equal.sym(Array<F32>, Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base), low) :
    {ANode{_, Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, upper, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}
  %Equal.sym(Array<F32>, Matrix.product_build(lower, rest, lo, ro, span, rows, columns, count, upper, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, upper), high) :
    {ANode{out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, lower, base), _} == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, 1n+lower, base) : Array<F32>}
  {==}

# Whatever the split, the parallel build over the copies returns the spec.
def build_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +count_exact: {count == Shape.logical_numel(Shape.dimensions(output)) : Nat}, +depth: Nat, +splits: Nat, +base: Nat) ->
  {Matrix.product_build(depth, splits, lo, ro, span, rows, columns, count, base, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)) == out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, count, depth, base) : Array<F32>}:
  match depth splits:
    case 1n+lower 1n+rest:
      fork_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lower, rest, base, build_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, lower, rest, base),
        build_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, lower, rest, Nat.add(Model.capacity(lower), base)),
        Array.clone(F32, Api.arr(ha, dl, fa)), {==}, Array.clone(F32, Api.arr(hb, dr, fb)), {==})
    case 0n _:
      tree_first(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 0n, base, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, 0n, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))), product_tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, 0n, base))
    case 1n+lower 0n:
      tree_first(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, 1n+lower, base, Matrix.product_tree(Matrix.Layout{lo, ro, span, rows, columns}, 1n+lower, count, base, (Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))), product_tree_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, count, lsrc, rsrc, output, left_extents, right_extents, output_extents, count_exact, 1n+lower, base))

# The writes of every cell, replayed on the owned storage `created` makes for
# the output, give the owned storage the parallel build fills.
def output_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +lsrc: Source<left, left_fill, left_ops, ha, dl, fa>, +rsrc: Source<right, right_fill, right_ops, hb, dr, fb>,
  +output: Shape.Shape,
  +left_extents: Fits(lo, span, rows, left),
  +right_extents: Fits(ro, span, columns, right),
  +output_extents: {Shape.extents(output) == [rows, columns] : List<&2, Nat>},
  +d: Nat, +fits: {Storage.bounds(d, U32.to_nat(Shape.count(output))) == True{} : Bool}, -f: {Storage.bounds(d, U32.to_nat(Shape.count(output))) == True{} : Bool}) ->
  {StorageLaws.replay(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output))), Storage.Owned{d, U32.to_nat(Shape.count(output)), Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}) == Storage.Owned{d, U32.to_nat(Shape.count(output)), Matrix.product_build(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), Matrix.product_build_balanced(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), f} : Storage.Storage}:
  Equal.trans(Storage.Storage, StorageLaws.replay(writes(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output))), Storage.Owned{d, U32.to_nat(Shape.count(output)), Array.new(F32, d, 0.0), ArrayCore.new_balanced(F32, d, 0.0), f}),
    Storage.Owned{d, U32.to_nat(Shape.count(output)), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output)), d, 0n), out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output)), d, 0n), f},
    Storage.Owned{d, U32.to_nat(Shape.count(output)), Matrix.product_build(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), Matrix.product_build_balanced(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), f},
    chain(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, d, U32.to_nat(Shape.count(output)), f, fits, Shape.count(output), Conversion.le_reflexive(U32.to_nat(Shape.count(output))), U32.to_nat(Shape.count(output)), Conversion.le_reflexive(U32.to_nat(Shape.count(output)))),
    Owned.owned_eq(d, U32.to_nat(Shape.count(output)), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output)), d, 0n), Matrix.product_build(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)),
      Equal.sym(Array<F32>, Matrix.product_build(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb)), out_spec(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output)), d, 0n),
        build_eq(lo, ro, span, rows, columns, left, left_fill, left_ops, ha, dl, fa, right, right_fill, right_ops, hb, dr, fb, U32.to_nat(Shape.count(output)), lsrc, rsrc, output, left_extents, right_extents, output_extents, Reads.count_exact(output), d, Matrix.product_splits(d, span), 0n)),
      out_balanced(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, U32.to_nat(Shape.count(output)), d, 0n), f)(Matrix.product_build_balanced(d, Matrix.product_splits(d, span), lo, ro, span, rows, columns, U32.to_nat(Shape.count(output)), 0n, Api.arr(ha, dl, fa), Api.arr(hb, dr, fb))))

# The inputs of the parallel product, as the elementwise export takes them.
def half_keeps(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, +index: U32) ->
  {Replayed.value(shape, fill, Replayed.snoc(ops, StorageLaws.First{}), index) == Replayed.value(shape, fill, ops, index) : F32}:
  Replayed.expected_snoc(ops, StorageLaws.First{}, U32.to_nat(Shape.count(shape)), index, fill)

def words_snoc(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, +previous: Nat, +word: F32, +other: F32,
  +before: List<&2, F32>, rest: {Laws.words(shape, fill, ops, previous) == before : List<&2, F32>}, last: {word == other : F32}) ->
  {List.append(&2, F32, Laws.words(shape, fill, ops, previous), [word]) == List.append(&2, F32, before, [other]) : List<&2, F32>}:
  Equal.trans(List<&2, F32>, List.append(&2, F32, Laws.words(shape, fill, ops, previous), [word]),
    List.append(&2, F32, before, [word]), List.append(&2, F32, before, [other]),
    Equal.cong(List<&2, F32>, List<&2, F32>, values => List.append(&2, F32, values, [word]), Laws.words(shape, fill, ops, previous), before, rest),
    Equal.cong(F32, List<&2, F32>, value => List.append(&2, F32, before, [value]), word, other, last))

# The First half of a clone lists the same words.

def words_first(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, +count: Nat) ->
  {Laws.words(shape, fill, Replayed.snoc(ops, StorageLaws.First{}), count) == Laws.words(shape, fill, ops, count) : List<&2, F32>}:
  match count:
    case 0n:
      {==}
    case 1n+previous:
      +position = U32.from_nat(previous)
      words_snoc(shape, fill, Replayed.snoc(ops, StorageLaws.First{}), previous,
        Replayed.value(shape, fill, Replayed.snoc(ops, StorageLaws.First{}), position), Replayed.value(shape, fill, ops, position),
        Laws.words(shape, fill, ops, previous), words_first(shape, fill, ops, previous), half_keeps(shape, fill, ops, position))

# `take` of an owned tensor hands back the First half of its clone and the
# Second half's array.

def take_owned_lift(+shape: Shape.Shape, +d: Nat, +n: Nat, -array: Array<F32>, pair: Array<F32> & Array<F32>,
  -same: {pair == Array.clone(F32, array) : Array<F32> & Array<F32>}, -b: Model.Balanced(F32, d, array),
  -f: {Storage.bounds(d, n) == True{} : Bool}, -fits: {n == Shape.logical_numel(Shape.dimensions(shape)) : Nat},
  -Q: (Core.Dynamic & Array<F32>) -> Type,
  h: @-kept: {Lifecycle.logical_length(StorageLaws.owner(Storage.Storage, Storage.finish_clone(d, n, array, pair, same, b, f))) ==
    Shape.logical_numel(Shape.dimensions(shape)) : Nat} ->
    Q((Core.Packed{shape, Core.TTensor{StorageLaws.owner(Storage.Storage, Storage.finish_clone(d, n, array, pair, same, b, f)), kept}},
      Pair.snd(Array<F32>, Array<F32>, pair)))) ->
  Q(Elementwise.take_owned(shape, d, n, array, pair, same, b, f, fits)):
  (kept, copy) = pair
  h(fits)

def storage_shift(-shape: Shape.Shape, -s: Storage.Storage, -t: Storage.Storage, e: {s == t : Storage.Storage},
  -R: @st: Storage.Storage -> @-k: {Lifecycle.logical_length(st) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} -> Type,
  h: @-k: {Lifecycle.logical_length(s) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} -> R(s, k)) ->
  @-k: {Lifecycle.logical_length(t) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} -> R(t, k):
  %e : (@-k: {Lifecycle.logical_length(_) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} -> R(_, k))
  h


# What the rest of the product asks of one input's `take`: the kept tensor,
# replayed with a history that keeps its words, and the copy the build reads,
# with its source.
def InputAt(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, -s: Storage.Storage,
  -Q: Core.Dynamic & Array<F32> -> Type) -> Type:
  @+kept: List<&2, StorageLaws.Op> ->
  @values: (@+other: U32 -> {Replayed.value(shape, fill, kept, other) == Replayed.value(shape, fill, ops, other) : F32}) ->
  @words: {Laws.words(shape, fill, kept, Shape.logical_numel(Shape.dimensions(shape))) == Laws.words(shape, fill, ops, Shape.logical_numel(Shape.dimensions(shape))) : List<&2, F32>} ->
  @+h: List<&2, Api.Effect> -> @+d: Nat -> @+f: F32 -> @+source: Source<shape, fill, ops, h, d, f> ->
  @-kept_fits: {Lifecycle.logical_length(StorageLaws.replay(kept, s)) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} ->
    Q((Core.Packed{shape, Core.TTensor{StorageLaws.replay(kept, s), kept_fits}}, Api.arr(h, d, f)))

def input_take(+shape: Shape.Shape, +fill: F32, +ops: List<&2, StorageLaws.Op>, -Q: Core.Dynamic & Array<F32> -> Type,
  h: InputAt(shape, fill, ops, StorageLaws.created(Shape.count(shape), fill), Q)) ->
  @-fits: {Lifecycle.logical_length(Replayed.storage(shape, fill, ops)) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} ->
  Q(Elementwise.take(Core.Packed{shape, Core.TTensor{Replayed.storage(shape, fill, ops), fits}})):
  Owned.created_lift(Shape.count(shape), fill, Conversion.shape_count_within(shape),
    s => (InputAt(shape, fill, ops, s, Q) -> @-fits: {Lifecycle.logical_length(StorageLaws.replay(ops, s)) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} ->
      Q(Elementwise.take(Core.Packed{shape, Core.TTensor{StorageLaws.replay(ops, s), fits}}))),
    zero => k => fits =>
      storage_shift(shape, Storage.Empty{}, StorageLaws.replay(ops, Storage.Empty{}),
        Equal.sym(Storage.Storage, StorageLaws.replay(ops, Storage.Empty{}), Storage.Empty{}, Owned.replay_empty(ops)),
        st => kk => Q(Elementwise.take(Core.Packed{shape, Core.TTensor{st, kk}})),
        kk => storage_shift(shape, StorageLaws.replay(ops, Storage.Empty{}), Storage.Empty{}, Owned.replay_empty(ops),
          st => k2 => Q((Core.Packed{shape, Core.TTensor{st, k2}}, Array.new(F32, 0n, 0.0))),
          k2 => k(ops)(other => {==})({==})(Nil{})(0n)(0.0)(NoCells{zero})(k2))(kk))(fits),
    d => fits_d => f => k => fits =>
      Owned.replay_lift(ops, d, U32.to_nat(Shape.count(shape)), fill, Nil{}, Api.hit_of(U32.to_nat(Shape.count(shape)), ops), {==},
        ArrayCore.new_balanced(F32, d, fill), f, fits_d,
        st => (@-fits: {Lifecycle.logical_length(st) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} ->
          (@-kk: {Lifecycle.logical_length(StorageLaws.step(st, StorageLaws.First{})) == Shape.logical_numel(Shape.dimensions(shape)) : Nat} ->
            Q((Core.Packed{shape, Core.TTensor{StorageLaws.step(st, StorageLaws.First{}), kk}}, Api.arr(history(shape, ops), d, fill)))) ->
          Q(Elementwise.take(Core.Packed{shape, Core.TTensor{st, fits}}))),
        c => fits2 => kc =>
          take_owned_lift(shape, d, U32.to_nat(Shape.count(shape)), Api.arr(Owned.norm(U32.to_nat(Shape.count(shape)), ops, Nil{}), d, fill),
            Array.clone(F32, Api.arr(Owned.norm(U32.to_nat(Shape.count(shape)), ops, Nil{}), d, fill)), {==}, c, f, fits2, Q, kc))(fits)(
        storage_shift(shape,
          StorageLaws.replay(Replayed.snoc(ops, StorageLaws.First{}), Storage.Owned{d, U32.to_nat(Shape.count(shape)), Array.new(F32, d, fill), ArrayCore.new_balanced(F32, d, fill), f}),
          StorageLaws.step(StorageLaws.replay(ops, Storage.Owned{d, U32.to_nat(Shape.count(shape)), Array.new(F32, d, fill), ArrayCore.new_balanced(F32, d, fill), f}), StorageLaws.First{}),
          FromValues.replay_snoc(ops, StorageLaws.First{}, Storage.Owned{d, U32.to_nat(Shape.count(shape)), Array.new(F32, d, fill), ArrayCore.new_balanced(F32, d, fill), f}),
          st => kk => Q((Core.Packed{shape, Core.TTensor{st, kk}}, Api.arr(history(shape, ops), d, fill))),
          k(Replayed.snoc(ops, StorageLaws.First{}))(other => half_keeps(shape, fill, ops, other))(words_first(shape, fill, ops, Shape.logical_numel(Shape.dimensions(shape))))(
            history(shape, ops))(d)(fill)(Normal{fits_d, {==}, {==}}))))(h)
