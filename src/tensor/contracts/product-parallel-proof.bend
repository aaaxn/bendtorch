# A cell of a row block at `position`, in row `row`: its fold is the cell's
# spec word.
def block_leaf_eq(+lo: Matrix.Order, +ro: Matrix.Order, +span: Nat, +rows: Nat, +columns: Nat, +left: Shape.Shape, +left_fill: F32, +left_ops: List<&2, StorageLaws.Op>, +ha: List<&2, Api.Effect>, +dl: Nat, +fa: F32, +right: Shape.Shape, +right_fill: F32, +right_ops: List<&2, StorageLaws.Op>, +hb: List<&2, Api.Effect>, +dr: Nat, +fb: F32, +count: Nat, +position: Nat, +row: Nat,
  +same: {Matrix.row_of(columns, position) == row : Nat}, +below: {Nat.is_lt(position, count) == True{} : Bool}) ->
  {out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, position, Nat.is_lt(position, count)) == fold_from(span, lo, ro, span, rows, columns, row, Matrix.column_of(columns, position), left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0) : F32}:
  %Equal.sym(Bool, Nat.is_lt(position, count), True{}, below) :
    {out_leaf(lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, position, _) == fold_from(span, lo, ro, span, rows, columns, row, Matrix.column_of(columns, position), left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0) : F32}
  %Equal.sym(Nat, Matrix.row_of(columns, position), row, same) :
    {DotFold.dot_fold(Laws.product_factors(_, Matrix.column_of(columns, position), lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, span), 0.0) == fold_from(span, lo, ro, span, rows, columns, row, Matrix.column_of(columns, position), left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0) : F32}
  Equal.sym(F32, fold_from(span, lo, ro, span, rows, columns, row, Matrix.column_of(columns, position), left, left_fill, left_ops, right, right_fill, right_ops, 0n, 0.0),
    DotFold.dot_fold(Laws.product_factors(row, Matrix.column_of(columns, position), lo, ro, span, rows, columns, left, left_fill, left_ops, right, right_fill, right_ops, span), 0.0),
    fold_factors(span, lo, ro, span, rows, columns, row, Matrix.column_of(columns, position), left, left_fill, left_ops, right, right_fill, right_ops, 0n, {==}))

